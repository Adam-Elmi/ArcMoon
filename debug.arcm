runtime ${
    import { onResize } from "arcmoon/utils";
    import { signal } from "arcmoon/reactive";
    const box = ArcMoon.ref(ArcMoon.defineRef("box"));
    const width = signal(0);
    onResize(box, (rect) => {
        width(Math.round(rect.width));
    });
}$
[doctype!]
[html = lang: "en"]
  [head]
    [meta = charset: "utf-8" !]
    [meta = name: "viewport", content: "width=device-width, initial-scale=1" !]
    [title]OnResize Demo[end]
  [end]

  [body = css.margin: "0", css.font-family: "sans-serif", css.padding: "32px"]

    [h1]Element-Level Resize Observer[end]
    [p]Drag the bottom-right corner of the box below to resize it:[end]

    [div = arcm-ref: "box",
           css.resize: "horizontal",
           css.overflow: "auto",
           css.width: "460px",
           css.min-width: "220px",
           css.max-width: "100%",
           css.padding: "20px",
           css.border: "2px solid #e4e4e7",
           css.border-radius: "8px",
           css.display: "flex",
           css.flex-direction: runtime ${ width() < 350 ? "column" : "row" }$,
           css.justify-content: "space-between",
           css.gap: "12px"]

      [div]
        [strong]Container Card[end]
        [p = css.margin: "4px 0 0", css.color: "#71717a", css.font-size: "14px"]
          Switches to stacked layout below 350px
        [end]
      [end]

      [span = css.padding: "4px 10px",
              css.background: "#f4f4f5",
              css.border-radius: "6px",
              css.align-self: "flex-start",
              css.font-family: "monospace"]
        runtime ${ width() }$px
      [end]
    [end]
  [end]
[end]
