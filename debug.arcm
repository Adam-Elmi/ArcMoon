runtime ${
    import { onScroll } from "arcmoon/utils";
    import { signal } from "arcmoon/reactive";
    const hidden = signal(false);
    const info = signal("scroll down");

    onScroll(window, ({ y, dy, direction }) => {
        if (direction === "down" && y > 80) hidden(true);
        else if (direction === "up") hidden(false);
        info(`y = ${Math.round(y)}, last move ${Math.round(dy)}px ${direction ?? ""}`);
    });
}$
[doctype!]
[html = lang: "en"]
  [head]
    [meta = charset: "utf-8" !]
    [meta = name: "viewport", content: "width=device-width, initial-scale=1" !]
    [title]onScroll Demo[end]
  [end]

  [body = css.margin: "0", css.font-family: "sans-serif"]
    [header = css.position: "fixed",
              css.top: "0",
              css.left: "0",
              css.right: "0",
              css.padding: "14px 32px",
              css.background: "#6366f1",
              css.color: "#ffffff",
              css.transition: "transform 0.25s",
              css.transform: runtime ${ hidden() ? "translateY(-100%)" : "translateY(0)" }$]
      [strong]Smart Header[end]
    [end]

    [div = css.padding: "80px 32px 32px", css.height: "2400px"]
      [h1]Scroll down, then up[end]
      [p]The header hides while you scroll down and returns as soon as you scroll up.[end]
      [p = css.position: "fixed", css.bottom: "16px", css.left: "32px", css.font-family: "monospace", css.color: "#71717a"]
        runtime ${ info() }$
      [end]
    [end]
  [end]
[end]