runtime ${
    import { scrollTo } from "arcmoon/utils";
    import { signal } from "arcmoon/reactive";
    const status = signal("Pick a section");

    const go = async (el, name) => {
        status(`Scrolling to ${name}...`);
        await scrollTo(el, { offset: 72 }); // 72 = height of the fixed header
        status(`Arrived at ${name}`);
    };

    const s1 = ArcMoon.ref(ArcMoon.defineRef("s1"));
    const s2 = ArcMoon.ref(ArcMoon.defineRef("s2"));
    const s3 = ArcMoon.ref(ArcMoon.defineRef("s3"));
    ArcMoon.ref(ArcMoon.defineRef("b1")).addEventListener("click", () => go(s1, "Section 1"));
    ArcMoon.ref(ArcMoon.defineRef("b2")).addEventListener("click", () => go(s2, "Section 2"));
    ArcMoon.ref(ArcMoon.defineRef("b3")).addEventListener("click", () => go(s3, "Section 3"));
}$
[doctype!]
[html = lang: "en"]
  [head]
    [meta = charset: "utf-8" !]
    [meta = name: "viewport", content: "width=device-width, initial-scale=1" !]
    [title]scrollTo Demo[end]
  [end]

  [body = css.margin: "0", css.font-family: "sans-serif"]
    [header = css.position: "fixed", css.top: "0", css.left: "0", css.right: "0", css.height: "72px", css.box-sizing: "border-box", css.padding: "0 24px", css.display: "flex", css.align-items: "center", css.gap: "12px", css.background: "#18181b", css.color: "#ffffff"]
      [button = arcm-ref: "b1"]Section 1[end]
      [button = arcm-ref: "b2"]Section 2[end]
      [button = arcm-ref: "b3"]Section 3[end]
      [span = css.margin-left: "auto", css.font-family: "monospace"]runtime ${ status() }$[end]
    [end]

    [section = arcm-ref: "s1", css.height: "700px", css.padding: "96px 24px 24px", css.box-sizing: "border-box", css.background: "#e0e7ff"][h2]Section 1[end][end]
    [section = arcm-ref: "s2", css.height: "700px", css.padding: "96px 24px 24px", css.box-sizing: "border-box", css.background: "#fce7f3"][h2]Section 2[end][end]
    [section = arcm-ref: "s3", css.height: "700px", css.padding: "96px 24px 24px", css.box-sizing: "border-box", css.background: "#dcfce7"][h2]Section 3[end][end]
  [end]
[end]