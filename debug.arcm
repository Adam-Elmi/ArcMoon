runtime ${
    import { limit, lockFocus } from "arcmoon/utils";
    import { signal } from "arcmoon/reactive";

    // 1. limit: spam clicks are throttled to once every 500ms
    const clicks = signal(0);
    const onClick = limit(() => clicks(clicks() + 1), 3000);
    ArcMoon.ref(ArcMoon.defineRef("btn")).addEventListener("click", onClick);

    // 2. lockFocus: keeps Tab key trapped inside modal
    const modal = ArcMoon.ref(ArcMoon.defineRef("modal"));
    let unlock = null;

    ArcMoon.ref(ArcMoon.defineRef("open")).addEventListener("click", () => {
        modal.style.display = "block";
        unlock = lockFocus(modal);
    });

    ArcMoon.ref(ArcMoon.defineRef("close")).addEventListener("click", () => {
        modal.style.display = "none";
        unlock?.();
    });
}$

[doctype!]
[html = lang: "en"]
  [body = css.font-family: "sans-serif", css.padding: "30px"]
    [h2]1. limit(fn, 500)[end]
    [button = arcm-ref: "btn"]Spam Click Me[end]
    [p]Throttled clicks: [b]runtime ${ clicks() }$[end][end]

    [hr = css.margin: "30px 0" !]

    [h2]2. lockFocus(target)[end]
    [button = arcm-ref: "open"]Open Modal[end]
    [button]Outside Button (Can't Tab here while open)[end]

    [div = arcm-ref: "modal", css.display: "none", css.border: "2px solid black", css.padding: "20px", css.margin-top: "20px", css.max-width: "250px"]
      [h3 = css.margin-top: "0"]Modal[end]
      [p = css.font-size: "13px"]Tab / Shift+Tab is trapped inside:[end]
      [input = placeholder: "Input 1" !][br!]
      [input = placeholder: "Input 2" !][br!][br!]
      [button = arcm-ref: "close"]Close[end]
    [end]
  [end]
[end]
