  "files": [
    "dist/node.js",
    "dist/eval-worker.js",
    "dist/browser.js",
    "dist/worker.js",
    "dist/core.js",
    "dist/reactive.js",
    "core",
    "node",
    "runtime",
    "cli",
    "assets"
