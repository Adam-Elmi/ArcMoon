{
	"name": "arcmoon-highlight",
	"version": "1.0.0",
	"description": "Syntax highlighting for ArcMoon (.arcm): static HTML, and a live editor with CodeMirror 6.",
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": "./dist/index.js",
		"./dynamic": "./dist/dynamic.js",
		"./diagnostics": "./dist/diagnostics.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"test": "vitest run",
		"build": "node scripts/build.js",
		"prepublishOnly": "npm test && npm run build"
	},
	"peerDependencies": {
		"@codemirror/commands": ">=6",
		"@codemirror/state": ">=6",
		"@codemirror/view": ">=6",
		"@codemirror/lint": ">=6"
	},
	"peerDependenciesMeta": {
		"@codemirror/commands": {
			"optional": true
		},
		"@codemirror/state": {
			"optional": true
		},
		"@codemirror/view": {
			"optional": true
		},
		"@codemirror/lint": {
			"optional": true
		}
	},
	"dependencies": {
		"acorn": "^8.18.0",
		"js-tokens": "^10.0.0"
	},
	"devDependencies": {
		"@codemirror/commands": "^6.10.3",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.1",
		"esbuild": "^0.28.2",
		"jsdom": "^30.1.1",
		"vitest": "^5.0.2",
		"@codemirror/lint": "^6.8.0"
	},
	"keywords": [
		"arcmoon",
		"arcm",
		"syntax-highlight",
		"highlight",
		"codemirror"
	],
	"author": "Adam Elmi",
	"license": "MIT",
	"homepage": "https://github.com/Adam-Elmi/ArcMoon/tree/main/tools/highlight#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Adam-Elmi/ArcMoon.git",
		"directory": "tools/highlight"
	}
}
